[project]
name = "pydtnn"
version = "1.1"
authors = [
    # Main contributors in alphabetically order.
    { name = "Adrián Castelló Gimeno",      email="adcastel@disca.upv.es" },
    { name = "Enrique S. Quintana-Ortí",    email="quintana@disca.upv.es" },
    { name = "Jose Ignacio Mestre Miravet", email="jmiravet@uji.es" },
    { name = "Manuel F. Dolz Zaragozá",     email="dolzm@uji.es" },
    { name = "Mar Catalán Carbó",           email="catalama@uji.es" },
    { name = "Miguel Ángel Prosper Quirós", email="mprosper@uji.es"},
    { name = "Paul Ximo Pluijter Izquierdo",email="pluijter@uji.es"},
    { name = "Sergio Barrachina Mir",       email="barrachi@uji.es" },
]
maintainers = [
    { name="Manuel F. Dolz Zaragozá", email="dolzm@uji.es" },
]
description = "Python Distributed Training of Neural Networks"
readme = "README.md"
requires-python = ">=3.13"
classifiers = [
    # See https://pypi.python.org/pypi?%3Aaction=list_classifiers
    # -----------------------------------------------------------
    # How mature is this project? Common values are
    #   3 - Alpha
    #   4 - Beta
    #   5 - Production/Stable
    'Development Status :: 5 - Production/Stable',
    # Who the project is intended for
    'Intended Audience :: Science/Research',
    'Topic :: Scientific/Engineering',
    'Topic :: Scientific/Engineering :: Artificial Intelligence',
    # License long description
    'License :: OSI Approved :: GNU General Public License v3 or later (GPLv3+)',
    # Python versions supported
    'Programming Language :: Python :: 3',
]
license = "GPLV3+"
license-files = ["LICENSE.rst", "LICENSE", "CREDITS.rst"]

dependencies = [
    # Base requirements
    "cython>=0.29.21",
    "matplotlib>=3.3.3",
    "numpy>=1.19.4",
    "prettytable>=2.1.0",
    "rich>=9.9.0",
    "scikit-image>=0.17.2",
    "scipy>=1.5.4",
    "tqdm>=4.55.0",
    "wheel>=0.38.0",
    "setuptools>=68.2.0,<80.0.0", # TODO: Check this!!:
    "bidict>=0.23.1",
    "intbitset>=3.1.0"
]

[project.urls]
Homepage = 'https://github.com/hpca-uji/PyDTNN'
Repository = 'https://github.com/hpca-uji/PyDTNN'

[build-system]
requires = ["setuptools >= 77.0.3"]
build-backend = "setuptools.build_meta"
